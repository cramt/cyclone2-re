# Verilog -> Cyclone II LEs for nextpnr-himbaechel (uarch cyclone2).
# Run after reading the design: `yosys -p "read_verilog top.v; script synth/cyclone2.ys; write_json top.json"`.
# Paths are relative to the repo root (`just open-build` runs from there).

read_verilog -lib synth/cells_sim.v
hierarchy -check -top top
synth -flatten -run :fine -top top
# `e ? d : 1'bz` -> $tribuf, before `opt -full` (whose -mux_undef takes z
# for undefined and would drop the enable). iopadmap merges them into the
# pin buffers.
tribuf
memory_map
opt -full
techmap -map +/techmap.v -map synth/arith_map.v
opt -fast
# Registers power up 0: make that explicit so registers that never leave
# it become constants. (Some only show up as stuck after LUT mapping; the
# nextpnr packer propagates those.)
setundef -zero -init
opt -full -sat
# Enable, asynchronous clear and synchronous clear (gated by the enable)
# are LAB-wide signals; one of each per LAB (the placer enforces it), the
# rest goes into the LUT in front.
dfflegalize -cell $_DFF_P_ 0 -cell $_DFFE_PP_ 0 -cell $_DFF_PP0_ 0 -cell $_DFFE_PP0P_ 0 -cell $_SDFF_PP0_ 0 -cell $_SDFFCE_PP0P_ 0
attrmap -remove init
techmap -map synth/cells_map.v
opt_expr -mux_undef
simplemap
abc -lut 4
opt -fast
techmap -map synth/cells_map.v
# Tri-state outputs and bidirs are one cell, COMBOUT unconnected on an
# output.
iopadmap -bits -inpad CY2_IBUF COMBOUT:PAD -outpad CY2_OBUF DATAOUT:PAD \
    -toutpad CY2_IOBUF OE:DATAOUT:PAD -tinoutpad CY2_IOBUF OE:COMBOUT:DATAOUT:PAD
opt_clean -purge
hierarchy -check
stat
check -assert
